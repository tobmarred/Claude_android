<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_launcher" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/university"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Studieren, wo du bist"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/welcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/semester"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/openCard"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/button_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Studierendenausweis anzeigen"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout style="@style/InfoBox">
            <TextView style="@style/InfoTitle" android:text="Über uns" />
            <TextView
                style="@style/InfoText"
                android:text="Die Aurelion Fernhochschule bietet berufsbegleitende Bachelor- und Masterstudiengänge vollständig online an – flexibel, digital und mit persönlicher Betreuung." />
        </LinearLayout>

        <LinearLayout style="@style/InfoBox">
            <TextView style="@style/InfoTitle" android:text="Termine" />
            <TextView
                style="@style/InfoText"
                android:text="• 04.11. Online-Sprechstunde Studienberatung\n• 15.11. Anmeldeschluss Prüfungen\n• 02.12. Virtueller Campus-Tag\n• 22.12. – 06.01. Vorlesungsfreie Zeit" />
        </LinearLayout>

        <LinearLayout style="@style/InfoBox">
            <TextView style="@style/InfoTitle" android:text="Studienservice" />
            <TextView
                style="@style/InfoText"
                android:text="Mo – Fr, 9 – 17 Uhr\nservice@aurelion-fh.example\n01234 567890" />
        </LinearLayout>

        <LinearLayout style="@style/InfoBox">
            <TextView style="@style/InfoTitle" android:text="Adresse" />
            <TextView
                style="@style/InfoText"
                android:text="Am Wissenspark 8\n34567 Lindenhain" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
